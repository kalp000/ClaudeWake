<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:label="Claude Wake"
        android:icon="@mipmap/ic_dark"
        android:roundIcon="@mipmap/ic_dark"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true" />

        <!--
            Launcher entries. Android cannot repaint an icon at runtime, so each icon theme is its
            own alias; the app turns exactly one of them on. This is why MainActivity itself has no
            launcher filter.
        -->
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Claude Wake"
            android:icon="@mipmap/ic_dark"
            android:roundIcon="@mipmap/ic_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Claude Wake"
            android:icon="@mipmap/ic_light"
            android:roundIcon="@mipmap/ic_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMono"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Claude Wake"
            android:icon="@mipmap/ic_mono"
            android:roundIcon="@mipmap/ic_mono">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".PatternActivity"
            android:exported="false"
            android:label="Unlock pattern"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver android:name=".ResetReceiver" android:exported="false" />

        <service
            android:name=".ClaudeAccessibilityService"
            android:exported="true"
            android:label="Claude Wake"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
